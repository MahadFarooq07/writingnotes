<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="PasteHandwriting" Width="1260" Height="860" MinWidth="1060" MinHeight="720" Background="#F4F3EE" FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <SolidColorBrush x:Key="Ink" Color="#202C27"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Ink}"/></Style>
  <Style TargetType="Button"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#233D31"/><Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="BorderBrush" Value="#D5DBD3"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.82"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#285D45"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#285D45"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="10,8"/><Setter Property="BorderBrush" Value="#D5DBD3"/><Setter Property="Background" Value="White"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="8,7"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="TabItem"><Setter Property="Padding" Value="22,12"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
 </Window.Resources>
 <Grid Margin="30,24,30,18">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="PasteHandwriting" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Your words. Your handwriting. Editable ink." Margin="0,5,0,0" Foreground="#67736C"/></StackPanel><Border Grid.Column="1" Background="#E4EBE0" CornerRadius="12" Padding="14,7" VerticalAlignment="Center"><TextBlock Text="LOCAL  ·  WINDOWS INK" FontSize="11" FontWeight="SemiBold" Foreground="#3F654B"/></Border></Grid>
  <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="8" Padding="16,12" Margin="0,20,0,16" BorderBrush="#DEE2D9" BorderThickness="1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="270"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Writing profile" VerticalAlignment="Center" Margin="0,0,16,0" FontWeight="SemiBold"/><ComboBox x:Name="Profiles" Grid.Column="1"/><TextBlock x:Name="ProfileSummary" Grid.Column="2" VerticalAlignment="Center" Margin="20,0,0,0" Foreground="#67736C" TextWrapping="Wrap"/><StackPanel Grid.Column="3" Orientation="Horizontal"><Button x:Name="ImportProfile" Content="Import profile"/><Button x:Name="ExportProfile" Content="Back up profile" Margin="0"/></StackPanel></Grid></Border>
  <TabControl x:Name="Tabs" Grid.Row="2" Background="Transparent" BorderThickness="0">
   <TabItem Header="Compose"><Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
     <TextBlock Text="Start with your text" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,10"/>
     <TextBox x:Name="SourceText" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="190" VerticalContentAlignment="Top" Text="The little things make a big difference.&#10;&#10;Write something worth remembering."/>
     <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,0"><TextBlock Text="Letter height"/><Slider x:Name="LetterSize" Minimum="12" Maximum="42" Value="22" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,7,0,0"/><TextBlock x:Name="SizeLabel" Foreground="#67736C" FontSize="12"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Line width"/><Slider x:Name="PageWidth" Minimum="280" Maximum="1100" Value="620" TickFrequency="20" IsSnapToTickEnabled="True" Margin="0,7,0,0"/><TextBlock x:Name="WidthLabel" Foreground="#67736C" FontSize="12"/></StackPanel></Grid>
     <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,0"><TextBlock Text="Natural variation"/><Slider x:Name="Variation" Minimum="0" Maximum="1" Value="0.35" Margin="0,7,0,0"/><TextBlock x:Name="VariationLabel" Foreground="#67736C" FontSize="12"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Pen width"/><Slider x:Name="PenWidth" Minimum="0.7" Maximum="3.5" Value="1.6" Margin="0,7,0,0"/><TextBlock x:Name="PenLabel" Foreground="#67736C" FontSize="12"/></StackPanel></Grid>
     <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,0"><TextBlock Text="Letter spacing"/><Slider x:Name="LetterSpacing" Minimum="0.03" Maximum="0.4" Value="0.12" Margin="0,7,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Ink color"/><ComboBox x:Name="InkColor" Margin="0,7,0,0"><ComboBoxItem Content="Forest" IsSelected="True"/><ComboBoxItem Content="Black"/><ComboBoxItem Content="Blue"/></ComboBox></StackPanel></Grid>
     <WrapPanel Margin="0,18,0,0"><Button x:Name="Generate" Content="Generate ink" Style="{StaticResource Primary}"/><Button x:Name="NewVariation" Content="New variation" Margin="0"/></WrapPanel>
     <TextBlock x:Name="ComposeNotice" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#68746C" FontSize="12"/>
    </StackPanel></ScrollViewer>
    <Border Grid.Column="2" Background="White" CornerRadius="9" BorderBrush="#DDE2DA" BorderThickness="1"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Margin="18,14"><TextBlock Text="Ink preview" FontWeight="SemiBold" VerticalAlignment="Center"/><ComboBox x:Name="PreviewMode" Width="140" HorizontalAlignment="Right" DockPanel.Dock="Right"><ComboBoxItem Content="View" IsSelected="True"/><ComboBoxItem Content="Select / move"/><ComboBoxItem Content="Erase stroke"/><ComboBoxItem Content="Erase part"/></ComboBox></DockPanel><ScrollViewer x:Name="PreviewScroll" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#F9FAF7"><InkCanvas x:Name="Preview" Background="White" Width="620" Height="450" EditingMode="None" Margin="18"/></ScrollViewer><WrapPanel Grid.Row="2" Margin="16"><Button x:Name="CopyInk" Content="Copy ink for OneNote" Style="{StaticResource Primary}"/><Button x:Name="SaveDocument" Content="Save"/><Button x:Name="LoadDocument" Content="Open"/><Button x:Name="ExportPng" Content="PNG" Margin="0"/></WrapPanel></Grid></Border>
   </Grid></TabItem>
   <TabItem Header="Your handwriting"><Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Build your writing profile" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Write one character at a time with your stylus. Keep its usual shape, dots, and pen lifts." TextWrapping="Wrap" Margin="0,10,0,16" Foreground="#67736C"/>
     <TextBlock Text="New profile name"/><TextBox x:Name="ProfileName" Text="My handwriting" Margin="0,7,0,10"/><Button x:Name="CreateProfile" Content="Create profile" Style="{StaticResource Primary}" HorizontalAlignment="Left"/>
     <TextBlock Text="Character to capture" Margin="0,22,0,7"/><WrapPanel><TextBox x:Name="CaptureCharacter" Text="a" MaxLength="1" Width="65" FontSize="24" Margin="0,0,8,0"/><Button x:Name="PreviousCharacter" Content="Previous"/><Button x:Name="NextCharacter" Content="Next" Margin="0"/></WrapPanel>
     <TextBlock x:Name="CaptureProgress" TextWrapping="Wrap" Margin="0,14,0,0"/><TextBlock Text="Aim for 3 samples of each letter. Start with lowercase, then add uppercase, numbers, and punctuation." TextWrapping="Wrap" Margin="0,10,0,0" Foreground="#67736C" FontSize="12"/>
     <TextBlock Text="Size guide" Margin="0,22,0,7" FontWeight="SemiBold"/><TextBlock Text="Rest letters on the lower line. Small letters reach the middle line; capitals and tall letters can reach the upper line. Descenders go below the baseline." TextWrapping="Wrap" Foreground="#67736C"/>
     <TextBlock x:Name="Coverage" TextWrapping="Wrap" Margin="0,18,0,0" FontFamily="Consolas" FontSize="12" Foreground="#67736C"/>
    </StackPanel></ScrollViewer>
    <Border Grid.Column="2" Background="White" CornerRadius="9" BorderBrush="#DDE2DA" BorderThickness="1" Padding="20"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock x:Name="CapturePrompt" Text="Write: a" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Use your normal writing style. You can save multiple examples of this character." TextWrapping="Wrap" Foreground="#67736C" Margin="0,8,0,18"/></StackPanel>
     <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><Grid Width="620" Height="300" Background="#FCFCF8"><Canvas IsHitTestVisible="False"><Line X1="25" X2="595" Y1="55" Y2="55" Stroke="#DDE3D8" StrokeDashArray="4 4"/><Line X1="25" X2="595" Y1="100" Y2="100" Stroke="#DDE3D8" StrokeDashArray="4 4"/><Line X1="25" X2="595" Y1="180" Y2="180" Stroke="#A8B9A5"/><TextBlock Text="baseline" Canvas.Left="520" Canvas.Top="185" Foreground="#9CA996" FontSize="11"/></Canvas><InkCanvas x:Name="CaptureCanvas" Background="Transparent" Width="620" Height="300" EditingMode="Ink"/></Grid></ScrollViewer>
     <WrapPanel Grid.Row="2" Margin="0,16,0,0"><Button x:Name="SaveSample" Content="Save sample" Style="{StaticResource Primary}"/><Button x:Name="ClearSample" Content="Clear canvas"/><Button x:Name="UndoSample" Content="Undo stroke"/><Button x:Name="RemoveSample" Content="Undo last saved sample" Margin="0"/></WrapPanel>
     <StackPanel Grid.Row="3" Margin="0,20,0,0"><TextBlock Text="Saved examples" FontWeight="SemiBold"/><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,10,0,0"><InkCanvas x:Name="SamplePreview" Background="#FCFCF8" EditingMode="None" Height="100" Width="620"/></ScrollViewer><TextBlock x:Name="CaptureNotice" TextWrapping="Wrap" Margin="0,14,0,0" Foreground="#67736C" FontSize="12"/></StackPanel>
    </Grid></Border>
   </Grid></TabItem>
   <TabItem Header="OneNote ink test"><Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Check editable ink" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="1. Copy the test strokes.&#10;&#10;2. Open a scratch page in OneNote and paste with Ctrl+V.&#10;&#10;3. Try the stroke eraser and lasso selection. The dot and stem of i are separate strokes.&#10;&#10;4. Save and reopen the page to check that it remains editable." TextWrapping="Wrap" Margin="0,16,0,20" Foreground="#67736C"/><Button x:Name="CopyTest" Content="Copy test ink" Style="{StaticResource Primary}" HorizontalAlignment="Left"/><TextBlock Text="Optional round trip" Margin="0,26,0,8" FontWeight="SemiBold"/><TextBlock Text="Lasso the pasted ink in OneNote and copy it. Then use Read copied ink to check whether stroke data returns." TextWrapping="Wrap" Foreground="#67736C"/><Button x:Name="ReadTest" Content="Read copied ink" HorizontalAlignment="Left" Margin="0,12,0,0"/><TextBlock x:Name="TestNotice" Margin="0,18,0,0" TextWrapping="Wrap" Foreground="#67736C"/></StackPanel><Border Grid.Column="2" Background="White" CornerRadius="9" BorderBrush="#DDE2DA" BorderThickness="1" Padding="22"><StackPanel><TextBlock Text="Independent pen strokes" FontWeight="SemiBold"/><InkCanvas x:Name="TestCanvas" Background="White" Width="600" Height="280" EditingMode="None" Margin="0,20,0,0"/><TextBlock Text="A line, a curve, a two-stroke t, and a dotted i. Nothing is flattened into an image." TextWrapping="Wrap" Foreground="#67736C" Margin="0,20,0,0"/></StackPanel></Border></Grid></TabItem>
  </TabControl>
  <TextBlock x:Name="Status" Grid.Row="3" Text="Ready" Margin="0,16,0,0" FontSize="12" Foreground="#647168" TextWrapping="Wrap"/>
 </Grid>
</Window>
